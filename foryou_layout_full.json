    {
        "id": "categories_row",
        "type": "ScrollView",
        "props": {
            "horizontal": true
        },
        "style": {
            "marginBottom": 24,
            "paddingHorizontal": 16,
            "flexDirection": "row"
        },
        "children": [
            {
                "type": "Text",
                "props": {
                    "text": "Top Categories"
                },
                "style": {
                    "marginBottom": 8,
