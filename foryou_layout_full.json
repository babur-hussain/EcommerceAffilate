                    "marginBottom": 12,
                    "color": "#111827"
                }
            },
            {
                "type": "ProductGrid",
                "props": {
                    "cardStyle": "horizontal"
                },
                "dataSource": {
                    "type": "DYNAMIC",
                    "query": {
                        "source": "products_generic",
