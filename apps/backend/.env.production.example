# Rate Limiting (configurable per tier)
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_SENSITIVE_MAX=30

# CORS — STRICT whitelist for production (comma-separated, NO wildcards)
CORS_ALLOWED_ORIGINS=https://localforvocalstartup.com,https://admin.localforvocalstartup.com,https://api.lfvs.in

# Super Admin Email Whitelist (comma-separated)
SUPER_ADMIN_EMAILS=__REPLACE_ME__
